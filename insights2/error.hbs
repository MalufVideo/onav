{{!< default}}

{{! The main content area }}
<main id="site-main" class="site-main">
    <section class="relative pt-32 pb-20 md:pt-40 md:pb-32 hero-gradient-overlay overflow-hidden min-h-screen flex items-center">
        <div class="absolute inset-0 w-full h-full pointer-events-none z-0">
            <div class="w-full h-full bg-gradient-to-r from-transparent via-gray-900 to-black opacity-80" style="background-image: radial-gradient(circle at 10% 20%, rgba(0, 255, 157, 0.15) 0%, transparent 50%), radial-gradient(circle at 85% 80%, rgba(0, 102, 255, 0.12) 0%, transparent 45%);"></div>
        </div>
        
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <div class="glass-card rounded-xl p-12 max-w-2xl mx-auto">
                <div class="mb-8">
                    <i class="fas fa-exclamation-triangle text-primary text-6xl mb-4"></i>
                    <h1 class="text-6xl md:text-8xl font-bold text-light-text mb-4">
                        {{statusCode}}
                    </h1>
                    <h2 class="text-2xl md:text-3xl font-bold mb-6 text-light-text">
                        {{#if message}}
                            {{message}}
                        {{else}}
                            {{#has statusCode="404"}}
                                Página não encontrada
                            {{else}}
                                Ops! Algo deu errado
                            {{/has}}
                        {{/if}}
                    </h2>
                </div>
                
                <div class="mb-8">
                    {{#has statusCode="404"}}
                        <p class="text-xl text-medium-text mb-6">
                            A página que você está procurando não existe ou foi movida.
                        </p>
                    {{else}}
                        <p class="text-xl text-medium-text mb-6">
                            Encontramos um problema técnico. Nossa equipe foi notificada e está trabalhando para resolver.
                        </p>
                    {{/has}}
                </div>
                
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="{{@site.url}}" class="btn-primary px-8 py-4 rounded-lg font-semibold text-lg hover:opacity-90 transition-all duration-200">
                        <i class="fas fa-home mr-2"></i>
                        Voltar ao Início
                    </a>
                    
                    {{#has statusCode="404"}}
                        <button onclick="history.back()" class="btn-secondary px-8 py-4 rounded-lg font-semibold text-lg hover:bg-opacity-10 transition-all duration-200">
                            <i class="fas fa-arrow-left mr-2"></i>
                            Página Anterior
                        </button>
                    {{else}}
                        <button onclick="location.reload()" class="btn-secondary px-8 py-4 rounded-lg font-semibold text-lg hover:bg-opacity-10 transition-all duration-200">
                            <i class="fas fa-redo mr-2"></i>
                            Tentar Novamente
                        </button>
                    {{/has}}
                </div>
                
                {{#has statusCode="404"}}
                    <div class="mt-12 pt-8 border-t border-gray-700">
                        <h3 class="text-light-text font-semibold mb-4">Pode ser que você esteja procurando por:</h3>
                        <div class="flex flex-wrap gap-2 justify-center">
                            <a href="{{@site.url}}" class="px-4 py-2 text-sm bg-gray-800 text-medium-text hover:text-primary hover:bg-gray-700 rounded-full transition-colors duration-200">
                                Posts Recentes
                            </a>
                            <a href="https://onav.com.br" class="px-4 py-2 text-sm bg-gray-800 text-medium-text hover:text-primary hover:bg-gray-700 rounded-full transition-colors duration-200">
                                Site Principal
                            </a>
                            <a href="https://onav.com.br#contact" class="px-4 py-2 text-sm bg-gray-800 text-medium-text hover:text-primary hover:bg-gray-700 rounded-full transition-colors duration-200">
                                Contato
                            </a>
                        </div>
                    </div>
                {{/has}}
            </div>
        </div>
    </section>
</main>