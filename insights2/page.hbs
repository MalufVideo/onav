{{!< default}}

{{! The main content area }}
<main id="site-main" class="site-main">
    <article class="page {{post_class}}">
        {{! Page header - respect @page.show_title_and_feature_image setting }}
        {{#if @page.show_title_and_feature_image}}
            <header class="page-header relative pt-32 pb-20 md:pt-40 md:pb-32 hero-gradient-overlay overflow-hidden">
                {{#if feature_image}}
                    <div class="absolute inset-0 w-full h-full pointer-events-none z-0">
                        <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" class="w-full h-full object-cover opacity-30">
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black opacity-80"></div>
                    </div>
                {{else}}
                    <div class="absolute inset-0 w-full h-full pointer-events-none z-0">
                        <div class="w-full h-full bg-gradient-to-r from-transparent via-gray-900 to-black opacity-80" style="background-image: radial-gradient(circle at 10% 20%, rgba(0, 255, 157, 0.15) 0%, transparent 50%), radial-gradient(circle at 85% 80%, rgba(0, 102, 255, 0.12) 0%, transparent 45%);"></div>
                    </div>
                {{/if}}
                
                <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                    <div class="text-center">
                        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6 text-light-text">
                            {{title}}
                        </h1>
                        
                        {{#if custom_excerpt}}
                            <p class="text-xl text-light-text mb-8 max-w-3xl mx-auto">
                                {{custom_excerpt}}
                            </p>
                        {{/if}}
                    </div>
                </div>
            </header>
        {{else}}
            {{! Minimal header when title/feature image are hidden }}
            <div class="pt-32 pb-8">
                <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                    {{#if custom_excerpt}}
                        <div class="text-center">
                            <p class="text-xl text-light-text mb-8 max-w-3xl mx-auto">
                                {{custom_excerpt}}
                            </p>
                        </div>
                    {{/if}}
                </div>
            </div>
        {{/if}}

        {{! Page content }}
        <section class="page-content py-20 bg-transparent">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                {{! Show page title in content area if not shown in header }}
                {{#unless @page.show_title_and_feature_image}}
                    <div class="mb-8">
                        <h1 class="text-4xl md:text-5xl font-bold leading-tight text-light-text">
                            {{title}}
                        </h1>
                    </div>
                {{/unless}}
                
                <div class="prose prose-lg prose-invert max-w-none">
                    {{content}}
                </div>
                
                {{! Page author and date info }}
                {{#if primary_author}}
                    <div class="mt-12 pt-8 border-t border-gray-700">
                        <div class="flex items-center space-x-4">
                            {{#if primary_author.profile_image}}
                                <img src="{{img_url primary_author.profile_image size="xs"}}" alt="{{primary_author.name}}" class="w-12 h-12 rounded-full">
                            {{/if}}
                            <div>
                                <p class="text-sm text-light-text font-semibold">Página criada por</p>
                                <p class="text-sm text-medium-text">{{primary_author.name}}</p>
                                {{#if updated_at}}
                                    <p class="text-xs text-medium-text">Atualizada em {{date updated_at format="DD MMM YYYY"}}</p>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                {{/if}}
                
                {{! Page tags if any }}
                {{#if tags}}
                    <div class="mt-8 pt-6 border-t border-gray-700">
                        <h3 class="text-light-text font-semibold mb-4 text-sm uppercase tracking-wider">Tags</h3>
                        <div class="flex flex-wrap gap-2">
                            {{#foreach tags}}
                                <a href="{{url}}" class="px-3 py-1 text-sm bg-gray-800 text-medium-text hover:text-primary hover:bg-gray-700 rounded-full transition-colors duration-200">
                                    {{name}}
                                </a>
                            {{/foreach}}
                        </div>
                    </div>
                {{/if}}
            </div>
        </section>
    </article>
</main>