{{!< default}}

{{! The main content area }}
<main id="site-main" class="site-main">
    {{! Author header }}
    <section class="relative pt-32 pb-20 md:pt-40 md:pb-32 hero-gradient-overlay overflow-hidden">
        <div class="absolute inset-0 w-full h-full pointer-events-none z-0">
            <div class="w-full h-full bg-gradient-to-r from-transparent via-gray-900 to-black opacity-80" style="background-image: radial-gradient(circle at 10% 20%, rgba(0, 255, 157, 0.15) 0%, transparent 50%), radial-gradient(circle at 85% 80%, rgba(0, 102, 255, 0.12) 0%, transparent 45%);"></div>
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center">
                <span class="text-primary font-semibold text-sm uppercase tracking-wider">Autor</span>
                
                {{#if primary_author.profile_image}}
                    <div class="mb-8">
                        <img src="{{img_url primary_author.profile_image size="l"}}" alt="{{primary_author.name}}" class="w-32 h-32 rounded-full mx-auto border-4 border-primary">
                    </div>
                {{/if}}
                
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
                    <span class="gradient-text">{{primary_author.name}}</span>
                </h1>
                
                {{#if primary_author.bio}}
                    <p class="text-xl text-light-text mb-8 max-w-3xl mx-auto">
                        {{primary_author.bio}}
                    </p>
                {{/if}}
                
                <div class="flex flex-col sm:flex-row items-center justify-center space-y-4 sm:space-y-0 sm:space-x-6 text-medium-text">
                    <div class="text-center">
                        <div class="text-2xl font-bold text-primary">{{plural pagination.total empty='0' singular='%' plural='%'}}</div>
                        <div class="text-sm">{{plural pagination.total empty='Posts' singular='Post' plural='Posts'}}</div>
                    </div>
                    
                    {{#if primary_author.location}}
                        <div class="flex items-center">
                            <i class="fas fa-map-marker-alt text-primary mr-2"></i>
                            <span>{{primary_author.location}}</span>
                        </div>
                    {{/if}}
                    
                    {{#if primary_author.website}}
                        <div class="flex items-center">
                            <i class="fas fa-globe text-primary mr-2"></i>
                            <a href="{{primary_author.website}}" target="_blank" class="hover:text-primary transition-colors duration-200">Site pessoal</a>
                        </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </section>

    {{! Posts by author }}
    <section id="author-posts" class="py-20 bg-transparent">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            {{#if posts}}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {{#foreach posts}}
                        <article class="glass-card rounded-xl overflow-hidden hover:transform hover:scale-105 transition-all duration-300">
                            {{#if feature_image}}
                                <a href="{{url}}" class="block">
                                    <div class="relative h-48 overflow-hidden">
                                        <img src="{{img_url feature_image size="m"}}" alt="{{title}}" class="w-full h-full object-cover" loading="lazy">
                                        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-60"></div>
                                    </div>
                                </a>
                            {{/if}}
                            
                            <div class="p-6">
                                {{#if primary_tag}}
                                    <span class="text-primary text-sm font-semibold uppercase tracking-wider">{{primary_tag.name}}</span>
                                {{/if}}
                                
                                <h2 class="text-xl md:text-2xl font-bold mt-2 mb-3 text-light-text">
                                    <a href="{{url}}" class="hover:text-primary transition-colors duration-200">{{title}}</a>
                                </h2>
                                
                                {{#if excerpt}}
                                    <p class="text-medium-text text-sm mb-4 line-clamp-3">{{excerpt}}</p>
                                {{/if}}
                                
                                <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-700">
                                    <time class="text-xs text-medium-text" datetime="{{date format="YYYY-MM-DD"}}">
                                        {{date format="DD MMM YYYY"}}
                                    </time>
                                    {{#if reading_time}}
                                        <span class="text-xs text-medium-text">{{reading_time}}</span>
                                    {{/if}}
                                </div>
                            </div>
                        </article>
                    {{/foreach}}
                </div>

                {{! Pagination }}
                {{pagination}}
                
            {{else}}
                {{! No posts }}
                <div class="text-center py-20">
                    <div class="glass-card rounded-xl p-12 max-w-md mx-auto">
                        <i class="fas fa-user-edit text-primary text-5xl mb-6"></i>
                        <h2 class="text-2xl font-bold mb-4 text-light-text">Nenhum post publicado</h2>
                        <p class="text-medium-text">Este autor ainda não publicou nenhum post.</p>
                        <a href="{{@site.url}}" class="btn-primary inline-block mt-6 px-6 py-3 rounded-lg font-semibold">
                            Ver todos os posts
                        </a>
                    </div>
                </div>
            {{/if}}
        </div>
    </section>
</main>