{{!< default}}

{{! The main content area }}
<main id="site-main" class="site-main">
    {{#post}}
    <article class="article {{post_class}}">
        {{! Article header }}
        <header class="article-header relative pt-32 pb-20 md:pt-40 md:pb-32 hero-gradient-overlay overflow-hidden">
            {{#if feature_image}}
                <div class="absolute inset-0 w-full h-full pointer-events-none z-0">
                    <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" class="w-full h-full object-cover opacity-30">
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black opacity-80"></div>
                </div>
            {{else}}
                <div class="absolute inset-0 w-full h-full pointer-events-none z-0">
                    <div class="w-full h-full bg-gradient-to-r from-transparent via-gray-900 to-black opacity-80" style="background-image: radial-gradient(circle at 10% 20%, rgba(0, 255, 157, 0.15) 0%, transparent 50%), radial-gradient(circle at 85% 80%, rgba(0, 102, 255, 0.12) 0%, transparent 45%);"></div>
                </div>
            {{/if}}

            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="text-center">
                    {{#if primary_tag}}
                        <a href="{{primary_tag.url}}" class="inline-block mb-4 px-4 py-1 text-sm bg-primary text-dark-bg hover:bg-secondary rounded-full transition-colors duration-200">
                            {{primary_tag.name}}
                        </a>
                    {{/if}}

                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6 text-light-text">
                        {{title}}
                    </h1>

                    {{#if custom_excerpt}}
                        <p class="text-xl text-light-text mb-8 max-w-3xl mx-auto">
                            {{custom_excerpt}}
                        </p>
                    {{/if}}

                    <div class="flex items-center justify-center space-x-6 text-sm text-medium-text">
                        {{#if primary_author}}
                            <div class="flex items-center space-x-2">
                                {{#if primary_author.profile_image}}
                                    <img src="{{img_url primary_author.profile_image size="xs"}}" alt="{{primary_author.name}}" class="w-8 h-8 rounded-full">
                                {{/if}}
                                <span>{{primary_author.name}}</span>
                            </div>
                        {{/if}}
                        <time datetime="{{date format="YYYY-MM-DD"}}">
                            {{date format="DD MMM YYYY"}}
                        </time>
                        {{#if reading_time}}
                            <span>{{reading_time}}</span>
                        {{/if}}
                    </div>
                </div>
            </div>
        </header>

        {{! Article content }}
        <section class="article-content py-20 bg-transparent">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="prose prose-lg prose-invert max-w-none">
                    {{content}}
                </div>

                {{! Article tags }}
                {{#if tags}}
                    <div class="mt-12 pt-8 border-t border-gray-700">
                        <h3 class="text-light-text font-semibold mb-4 text-sm uppercase tracking-wider">Tags</h3>
                        <div class="flex flex-wrap gap-2">
                            {{#foreach tags}}
                                <a href="{{url}}" class="px-3 py-1 text-sm bg-gray-800 text-medium-text hover:text-primary hover:bg-gray-700 rounded-full transition-colors duration-200">
                                    {{name}}
                                </a>
                            {{/foreach}}
                        </div>
                    </div>
                {{/if}}

                {{! Author bio }}
                {{#if primary_author}}
                    <div class="mt-12 pt-8 border-t border-gray-700">
                        <div class="flex items-start space-x-4">
                            {{#if primary_author.profile_image}}
                                <img src="{{img_url primary_author.profile_image size="s"}}" alt="{{primary_author.name}}" class="w-20 h-20 rounded-full">
                            {{/if}}
                            <div class="flex-1">
                                <h3 class="text-light-text font-semibold mb-2">{{primary_author.name}}</h3>
                                {{#if primary_author.bio}}
                                    <p class="text-medium-text text-sm mb-3">{{primary_author.bio}}</p>
                                {{/if}}
                                {{#if primary_author.website}}
                                    <a href="{{primary_author.website}}" class="text-sm text-primary hover:text-secondary transition-colors duration-200">
                                        Visite o site →
                                    </a>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                {{/if}}
            </div>
        </section>

        {{! Newsletter signup section }}
        <section class="newsletter-section py-16 bg-gray-900 bg-opacity-50">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center">
                    <h2 class="text-3xl font-bold text-light-text mb-4">Receba nossas novidades</h2>
                    <p class="text-medium-text mb-8 max-w-2xl mx-auto">
                        Fique por dentro das últimas tendências em produção virtual e tecnologia para eventos.
                    </p>
                    <form class="max-w-md mx-auto" data-members-form>
                        <div class="flex gap-2">
                            <input
                                type="email"
                                name="email"
                                placeholder="Seu e-mail"
                                class="flex-1 px-4 py-3 bg-dark-bg border border-gray-700 rounded-lg text-light-text placeholder-medium-text focus:outline-none focus:border-primary transition-colors duration-200"
                                required
                            >
                            <button
                                type="submit"
                                class="px-6 py-3 bg-primary text-dark-bg font-semibold rounded-lg hover:bg-secondary transition-colors duration-200"
                            >
                                Inscrever
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </article>
    {{/post}}
</main>
