{{#if pagination.pages}}
    <nav class="pagination" role="navigation">
        {{#if pagination.prev}}
            <a href="{{page_url pagination.prev}}" class="pagination__prev">
                <i class="fas fa-chevron-left mr-2"></i>
                Anterior
            </a>
        {{/if}}

        {{#foreach pagination.pages}}
            {{#if current}}
                <span class="pagination__page current">{{page}}</span>
            {{else}}
                <a href="{{page_url page}}" class="pagination__page">{{page}}</a>
            {{/if}}
        {{/foreach}}

        {{#if pagination.next}}
            <a href="{{page_url pagination.next}}" class="pagination__next">
                Próxima
                <i class="fas fa-chevron-right ml-2"></i>
            </a>
        {{/if}}
    </nav>

    <div class="pagination-info text-center mt-4 text-medium-text text-sm">
        Página {{pagination.page}} de {{pagination.pages}} 
        ({{pagination.total}} {{plural pagination.total empty='posts' singular='post' plural='posts'}})
    </div>
{{/if}}