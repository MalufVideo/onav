{
  "name": "onav-website",
  "version": "1.0.0",
  "description": "On + Av website with LED calculator and virtual production services",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:css": "node ./node_modules/tailwindcss/lib/cli.js -i ./css/tailwind-input.css -o ./css/tailwind.css --minify",
    "build": "npm run build:css && npm install --prefix pipeline && npm run build --prefix pipeline",
    "vercel-build": "npm run build:css"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.1",
    "resend": "^4.6.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "playwright": "^1.51.1",
    "postcss": "^8.5.6",
    "supabase": "^2.22.6",
    "tailwindcss": "^3.4.0"
  },
  "engines": {
    "node": "22.x"
  }
}
