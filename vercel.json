{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**/*",
          "admin/**/*",
          "led/**/*",
          "img/**/*",
          "css/**/*",
          "js/**/*",
          "tours/**/*",
          "equipamentos-on/**/*",
          "*.html",
          "*.xml"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}